# --- AI provider -----------------------------------------------------------
# "mock" (default, no key required, deterministic) or "anthropic" (real Claude).
AI_PROVIDER=mock

# Required only when AI_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# Model id used by the anthropic provider.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Server ----------------------------------------------------------------
PORT=8787

# --- Evidence selection ----------------------------------------------------
# Max characters of selected log evidence sent to the AI model per investigation.
EVIDENCE_CHAR_BUDGET=12000
